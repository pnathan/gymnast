# A vertical-slice application specification, in the draft compact surface.
# Hand-translated from examples/todo.lisp. Known deliberate deltas from the
# Lamedh spec are catalogued in docs/ir-contract-deltas.md.

spec todo_rust = v 0.1 owner product
  exports UserId, ListId, TaskId, TodoList, Task, todo_service

use oddities/profiles/todo_standard @ 1.0
  (sharing_limit 256, identity_provider google)

application todo = (modules todo, default_acceptance production)

actor user = person (identity google_openid (issuer, subject))

mode UserId  = opaque text
mode ListId  = opaque text
mode TaskId  = opaque text
mode Version = opaque int

mode Role       = enum (owner, editor, viewer)
mode TaskStatus = enum (open, completed)
mode TaskState  = enum (active, trashed)

mode Due = union (date_only local_date, at zoned_datetime)

mode TodoList = struct (
  ListId id,
  text (1..200) title,
  UserId owner,
  Version version )

mode Task = struct (
  TaskId id,
  ListId list,
  text (1..500) title,
  text (..20000) notes,
  TaskStatus status,
  TaskState state,
  opt Due due,
  opt UserId assignee,
  Version version )

component todo_app = (
  responsibility "Manage persistent, shareable Todo lists",
  provides todo_service,
  uses (google_identity, durable_store, clock, id_source) )

interface todo_service = for user (
  cmd create_task = (ListId list, text title, opt Due due) Task
      ! (unauthenticated, forbidden, not_found, conflict),

  qry query_tasks = (ListId list, opt Cursor cursor) Page (Task)
      ! (unauthenticated, not_found, invalid_cursor),

  cmd invite = (ListId list, UserId principal, Role role) Membership
      ! (unauthenticated, forbidden, not_found, sharing_limit) )

state todo_state = (
  of aggregate (TodoList, Task, Membership, Invitation),
  owner todo_app,
  durability durable,
  initial empty,
  aggregate per_list ListId,
  versioned optimistic,
  consistency serial_per_list )

flow authenticated_user_to_service = user -> todo_service : cmd
  (grant authenticated_session, deny raw_google_token)

behavior create_task = on todo_service.create_task (user, request) (
  reads (memberships, todo_lists), writes tasks,
  atomic list request.list, idempotency command_key;

  requires authenticated (user);
  requires may_edit_list (pre, user, request.list);
  ensures  post = insert_task (pre, request, result);
  returns  result;
  fails forbidden
    when not may_edit_list (pre, user, request.list)
    preserves all_state;
  emits task_created exactly_once_logically )

behavior invite_user = on todo_service.invite (user, request) (
  reads (memberships, invitations), writes invitations,
  atomic list_membership request.list, idempotency command_key;

  requires is_owner (pre, user, request.list);
  requires other_principal_count (pre, request.list) < sharing_limit;
  ensures  post = invite_principal (pre, request);
  fails sharing_limit
    when other_principal_count (pre, request.list) = sharing_limit
    preserves all_state )

inv owner_isolation = on todo_state
  always no_observation_without_active_membership

inv sharing_limit = on todo_state
  always for all TodoList list: other_principal_count (list) <= sharing_limit

constraint collaborative_capacity = workload on todo_service
  under (virtual_users 500, duration 30 min, read_p95 300 ms, write_p95 500 ms)
  must lost_updates = 0 and invariant_violations = 0

synthesis prototype = target rust / actix (
  platform gymnast_reference_platform_v1,
  model small_code_model (class nano, temperature 0, max_attempts 3),
  attempts 3,
  must_not (invent_product_semantics, add_unpinned_dependencies) )

acceptance production = of todo_app (
  property create_then_read =
    generate (actor authenticated_editor of user, task valid_task)
    execute (create_task (actor, task); query_tasks (actor, task.list))
    must contains_equivalent (result, task),

  property viewer_cannot_mutate =
    generate (actor authenticated_viewer of user, task valid_task)
    execute create_task (actor, task)
    must fails_with forbidden,

  scenario sharing_boundary = (
    given owner = authenticated_owner;
    when invite_distinct (owner, sharing_limit); then succeeds;
    when invite_distinct (owner, sharing_limit + 1); then fails_with sharing_limit ),

  concurrency boundary_race = (actors 500, schedule adversarial)
    must active_and_pending_other_principals <= sharing_limit,

  fault durable_restart = after acknowledged_write inject restart
    must read_your_acknowledged_write,

  coverage (every_operation, every_error, every_transition,
            every_invariant, boundaries),

  execution (clock virtual, randomness seeded,
             network controlled, timezone "UTC") )
