# A bug tracker clone in the compact surface: project members file and
# triage bugs; only the assignee or a maintainer may resolve; per-project
# open-bug capacity is bounded; every state change is journaled.
# Target: Python / Django.

spec bug_tracker = v 0.1 owner engineering
  exports BugId, ProjectId, Bug, BugStatus, tracker_service

application bug_tracker = (modules bug_tracker, default_acceptance production)

actor member = person (identity oidc_login (issuer, subject))

mode BugId     = opaque text
mode ProjectId = opaque text
mode UserId    = opaque text
mode Version   = opaque int
mode Cursor    = opaque text
mode Page      = opaque text

mode Severity  = enum (blocker, major, minor, trivial)
mode BugStatus = enum (open, triaged, in_progress, resolved, closed)
mode MemberRole = enum (maintainer, developer, reporter)

mode ReportedAt = union (at zoned_datetime, day local_date)

mode Bug = struct (
  BugId id,
  ProjectId project,
  text (1..200) title,
  text (..20000) description,
  Severity severity,
  BugStatus status,
  ReportedAt reported_at,
  opt UserId assignee,
  Version version )

mode Resolution = struct (
  BugId bug,
  UserId resolver,
  text (1..2000) note,
  Version version )

component tracker_app = (
  responsibility "Track, triage, and resolve bugs per project with bounded backlogs",
  provides tracker_service,
  uses (oidc_identity, durable_store, clock, id_source) )

interface tracker_service = for member (
  cmd file_bug = (ProjectId project, text title, Severity severity) Bug
      ! (unauthenticated, forbidden, not_found, backlog_full),

  cmd resolve_bug = (BugId bug, text note) Resolution
      ! (unauthenticated, forbidden, not_found, already_resolved),

  cmd assign_bug = (BugId bug, UserId assignee) Bug
      ! (unauthenticated, forbidden, not_found, already_resolved),

  qry list_bugs = (ProjectId project, opt Cursor cursor) Page (Bug)
      ! (unauthenticated, forbidden, not_found, invalid_cursor) )

state tracker_state = (
  of aggregate (Bug, Resolution),
  owner tracker_app,
  durability durable,
  initial empty,
  aggregate per_project ProjectId,
  versioned optimistic,
  consistency serial_per_project )

flow member_to_tracker = member -> tracker_service : cmd
  (grant authenticated_session, deny raw_oidc_token)

behavior file_bug = on tracker_service.file_bug (member, request) (
  reads (memberships, projects), writes bugs,
  atomic project request.project, idempotency command_key;

  requires authenticated (member);
  requires is_project_member (pre, member, request.project);
  requires open_bug_count (pre, request.project) < 5000;
  ensures  post = journal_bug (pre, request, result);
  returns  result;
  fails backlog_full
    when open_bug_count (pre, request.project) = 5000
    preserves all_state;
  emits bug_filed exactly_once_logically )

behavior resolve_bug = on tracker_service.resolve_bug (member, request) (
  reads (bugs, memberships), writes resolutions,
  atomic bug request.bug, idempotency command_key;

  requires may_resolve (pre, member, request.bug);
  ensures  post = journal_resolution (pre, request, result);
  returns  result;
  fails forbidden
    when not may_resolve (pre, member, request.bug)
    preserves all_state )

behavior assign_bug = on tracker_service.assign_bug (member, request) (
  reads (bugs, memberships), writes bugs,
  atomic bug request.bug, idempotency command_key;

  requires may_triage (pre, member, request.bug);
  requires is_project_member (pre, request.assignee, request.bug);
  ensures  post = record_assignment (pre, request, result);
  returns  result;
  fails forbidden
    when not may_triage (pre, member, request.bug)
    preserves all_state )

inv no_orphan_resolutions = on tracker_state
  always every_resolution_references_existing_bug

inv backlog_ceiling = on tracker_state
  always for all ProjectId p: open_bug_count (p) <= 5000

constraint triage_capacity = workload on tracker_service
  under (virtual_users 300, duration 20 min, read_p95 250 ms, write_p95 400 ms)
  must lost_updates = 0 and duplicate_resolutions = 0

synthesis prototype = target python / django (
  platform gymnast_reference_platform_v1,
  model small_code_model (class nano, temperature 0, max_attempts 3),
  attempts 3,
  must_not (invent_product_semantics, add_unpinned_dependencies) )

acceptance production = of tracker_app (
  property file_then_list =
    generate (actor project_member, bug valid_bug)
    execute (file_bug (actor, bug); list_bugs (actor, bug.project))
    must contains_equivalent (result, bug),

  property nonmember_cannot_file =
    generate (actor outside_user, bug valid_bug)
    execute file_bug (actor, bug)
    must fails_with forbidden,

  scenario backlog_boundary = (
    given reporter = project_member;
    when file_distinct (reporter, 5000); then succeeds;
    when file_distinct (reporter, 5001); then fails_with backlog_full ),

  concurrency resolve_race = (actors 300, schedule adversarial)
    must duplicate_resolutions = 0,

  fault durable_restart = after acknowledged_write inject restart
    must read_your_acknowledged_write,

  coverage (every_operation, every_error, every_transition,
            every_invariant, boundaries),

  execution (clock virtual, randomness seeded,
             network controlled, timezone "UTC") )
