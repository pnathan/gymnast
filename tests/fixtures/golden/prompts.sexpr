:\n    Guarantees: globally-unique, collision-resistant, sortable\n    Failure modes: entropy-exhausted\n  identity (v1.0):\n    Guarantees: token-validation, session-binding, principal-extraction\n    Failure modes: unauthenticated, token-expired, provider-unavailable\n  repository (v1.0):\n    Guarantees: typed-queries, aggregate-loading, optimistic-locking\n    Failure modes: not-found, version-conflict, connection-lost\n\nSTATE MODEL\n  todo-state:\n    Aggregate: (PER-LIST LISTID)\n    Versioning: optimistic\n    Consistency: serial-per-list\n    Durability: durable\n    Entities: todolist, task, membership, invitation\n\nBEHAVIORAL REFERENCE\n  create-task (todo-service/create-task):\n    Actor: USER\n    Reads: memberships, todo-lists\n    Writes: tasks\n    Atomic scope: (LIST REQUEST / LIST)\n    Idempotency: command-key\n    Preconditions:\n      (AUTHENTICATED? USER)\n      (MAY-EDIT-LIST? PRE USER REQUEST / LIST)\n    Postconditions:\n      (= POST (INSERT-TASK PRE REQUEST RESULT))\n    Failures:\n      forbidden when (NOT (MAY-EDIT-LIST? PRE USER REQUEST / LIST)), preserves all-state\n    Emissions:\n      (TASK-CREATED :EXACTLY-ONCE-LOGICALLY)\n\n  invite-user (todo-service/invite):\n    Actor: USER\n    Reads: memberships, invitations\n    Writes: invitations\n    Atomic scope: (LIST-MEMBERSHIP REQUEST / LIST)\n    Idempotency: command-key\n    Preconditions:\n      (OWNER? PRE USER REQUEST / LIST)\n      (< (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256)\n    Postconditions:\n      (= POST (INVITE-PRINCIPAL PRE REQUEST))\n    Failures:\n      sharing-limit when (= (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256), preserves all-state\n\n\nOBLIGATIONS\n  authorization-before-observation\n  contract-conformance\n  idempotent-retries\n\nPROHIBITIONS\n  access-filesystem\n  access-network\n  add-endpoints\n\nAUTHORIZED FILES\n(\"generated/service/handlers.rb\")\n\nDEPENDENCIES\n((\"todo-spec/plan/authorization-policy\" \"fnv1a64:4536890319692371700\") (\"todo-spec/plan/interface-contracts\" \"fnv1a64:-1247764064418828680\") (\"todo-spec/plan/persistence\" \"fnv1a64:8862800152182173293\") (\"todo-spec/plan/transition-kernel\" \"fnv1a64:-5625329781620648055\"))\n\nOUTPUT PROTOCOL\n(CANDIDATE (SCHEMA \"gymnast.candidate/0.1\") (NODE-ID \"todo-spec/plan/service-handlers\") (FILES ((\"generated/service/handlers.rb\" \"<valid Ruby source code>\"))) (IMPLEMENTS \"<ir-node-id-list>\") (EDGE-USES ()) (ASSUMPTIONS ()) (UNRESOLVED ()))\n\nAUTHORITATIVE INPUT (reference)\n(#S(GYMNAST-IR-NODE \"todo-spec/behavior/create-task\" BEHAVIOR CREATE-TASK ((:ATOMIC (LIST REQUEST / LIST)) (:IDEMPOTENCY COMMAND-KEY) (:ON (TODO-SERVICE / CREATE-TASK USER REQUEST)) (:READS (MEMBERSHIPS TODO-LISTS)) (:WRITES (TASKS))) ((REQUIRES (AUTHENTICATED? USER)) (REQUIRES (MAY-EDIT-LIST? PRE USER REQUEST / LIST)) (ENSURES (= POST (INSERT-TASK PRE REQUEST RESULT))) (RETURNS RESULT) (FAILS FORBIDDEN :WHEN (NOT (MAY-EDIT-LIST? PRE USER REQUEST / LIST)) :PRESERVES ALL-STATE) (EMITS TASK-CREATED :EXACTLY-ONCE-LOGICALLY)) FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/behavior/invite-user\" BEHAVIOR INVITE-USER ((:ATOMIC (LIST-MEMBERSHIP REQUEST / LIST)) (:IDEMPOTENCY COMMAND-KEY) (:ON (TODO-SERVICE / INVITE USER REQUEST)) (:READS (MEMBERSHIPS INVITATIONS)) (:WRITES (INVITATIONS))) ((REQUIRES (OWNER? PRE USER REQUEST / LIST)) (REQUIRES (< (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256)) (ENSURES (= POST (INVITE-PRINCIPAL PRE REQUEST))) (FAILS SHARING-LIMIT :WHEN (= (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256) :PRESERVES ALL-STATE)) FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/constraint/collaborative-capacity\" CONSTRAINT COLLABORATIVE-CAPACITY ((:CLASS WORKLOAD) (:MUST (AND (= LOST-UPDATES 0) (= INVARIANT-VIOLATIONS 0))) (:SCOPE TODO-SERVICE) (:UNDER (WORKLOAD :VIRTUAL-USERS 500 :DURATION (MINUTES 30) :READ-P95 (MILLISECONDS 300) :WRITE-P95 (MILLISECONDS 500)))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/interface/todo-service\" INTERFACE TODO-SERVICE () ((COMMAND CREATE-T