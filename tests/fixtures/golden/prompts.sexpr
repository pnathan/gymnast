ndidate ...) is metadata framing; file content strings inside it are real ruby source code.\nESCAPING: file content is inside S-expression double-quoted strings. Backslash-escape every literal double-quote and every literal backslash in file content. Prefer single-quoted strings in ruby where the language allows it.\nUse Rails conventions: ActiveRecord models, ApplicationRecord base class, standard Rails error handling.\n\nCAPABILITY CONTRACTS\n  clock (v1.0):\n    Guarantees: monotonic, utc-wall-time, virtual-in-tests\n    Failure modes: drift-beyond-tolerance\n  id-source (v1.0):\n    Guarantees: globally-unique, collision-resistant, sortable\n    Failure modes: entropy-exhausted\n\nSTATE MODEL\n  todo-state:\n    Aggregate: (PER-LIST LISTID)\n    Versioning: optimistic\n    Consistency: serial-per-list\n    Durability: durable\n    Entities: todolist, task, membership, invitation\n\nTYPE REFERENCE\n  due (variant): date-only localdate | at zoneddatetime\n  listid (opaque text)\n  role (enum): owner | editor | viewer\n  task (record):\n    id: TASKID\n    list: LISTID\n    title: (TEXT :MIN 1 :MAX 500)\n    notes: (TEXT :MAX 20000)\n    status: TASKSTATUS\n    state: TASKSTATE\n    due: (OPTIONAL DUE)\n    assignee: (OPTIONAL USERID)\n    version: VERSION\n  taskid (opaque text)\n  taskstate (enum): active | trashed\n  taskstatus (enum): open | completed\n  todolist (record):\n    id: LISTID\n    title: (TEXT :MIN 1 :MAX 200)\n    owner: USERID\n    version: VERSION\n  userid (opaque text)\n  version (opaque integer)\n\nBEHAVIORAL REFERENCE\n  create-task (todo-service/create-task):\n    Actor: USER\n    Reads: memberships, todo-lists\n    Writes: tasks\n    Atomic scope: (LIST REQUEST / LIST)\n    Idempotency: command-key\n    Preconditions:\n      (AUTHENTICATED? USER)\n      (MAY-EDIT-LIST? PRE USER REQUEST / LIST)\n    Postconditions:\n      (= POST (INSERT-TASK PRE REQUEST RESULT))\n    Failures:\n      forbidden when (NOT (MAY-EDIT-LIST? PRE USER REQUEST / LIST)), preserves all-state\n    Emissions:\n      (TASK-CREATED :EXACTLY-ONCE-LOGICALLY)\n\n  invite-user (todo-service/invite):\n    Actor: USER\n    Reads: memberships, invitations\n    Writes: invitations\n    Atomic scope: (LIST-MEMBERSHIP REQUEST / LIST)\n    Idempotency: command-key\n    Preconditions:\n      (OWNER? PRE USER REQUEST / LIST)\n      (< (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256)\n    Postconditions:\n      (= POST (INVITE-PRINCIPAL PRE REQUEST))\n    Failures:\n      sharing-limit when (= (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256), preserves all-state\n\n\nOBLIGATIONS\n  deterministic-under-same-input\n  implements-transition-system\n  preserves-invariants\n\nPROHIBITIONS\n  invent-errors\n  perform-io\n  weaken-preconditions\n\nAUTHORIZED FILES\n(\"generated/domain/transitions.rb\")\n\nDEPENDENCIES\n((\"todo-spec/plan/design-contracts\" \"fnv1a64:-3301971193811907362\"))\n\nOUTPUT PROTOCOL\n(CANDIDATE (SCHEMA \"gymnast.candidate/0.1\") (NODE-ID \"todo-spec/plan/transition-kernel\") (FILES ((\"generated/domain/transitions.rb\" \"<valid Ruby source code>\"))) (IMPLEMENTS \"<ir-node-id-list>\") (EDGE-USES ()) (ASSUMPTIONS ()) (UNRESOLVED ()))\n\nAUTHORITATIVE INPUT (reference)\n(#S(GYMNAST-IR-NODE \"todo-spec/behavior/create-task\" BEHAVIOR CREATE-TASK ((:ATOMIC (LIST REQUEST / LIST)) (:IDEMPOTENCY COMMAND-KEY) (:ON (TODO-SERVICE / CREATE-TASK USER REQUEST)) (:READS (MEMBERSHIPS TODO-LISTS)) (:WRITES (TASKS))) ((REQUIRES (AUTHENTICATED? USER)) (REQUIRES (MAY-EDIT-LIST? PRE USER REQUEST / LIST)) (ENSURES (= POST (INSERT-TASK PRE REQUEST RESULT))) (RETURNS RESULT) (FAILS FORBIDDEN :WHEN (NOT (MAY-EDIT-LIST? PRE USER REQUEST / LIST)) :PRESERVES ALL-STATE) (EMITS TASK-CREATED :EXACTLY-ONCE-LOGICALLY)) FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/behavior/invite-user\" BEHAVIOR INVITE-USER ((:ATOMIC (LIST-MEMBERSHIP REQUEST / LIST)) (:IDEMPOTENCY COMMAND-KEY) (:ON (TODO-SERVICE / INVITE USER REQUEST)) (:READS (MEMBERSHIPS INVITATIONS)) (:WRITES (INVITATIONS))) ((REQUIRES (OWNER? PRE USER REQUEST / LIST)) (REQUIRES (< (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256)) (ENSURES (= POST (INVITE-PRINCIPAL PRE REQUEST))) (FAILS SHARING-LIMIT :WHEN (= (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256) :PRESERVES ALL-STATE)) FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/invariant/owner-isolation\" INVARIANT OWNER-ISOLATION ((:ALWAYS (NO-OBSERVATION-WITHOUT-ACTIVE-MEMBERSHIP)) (:SCOPE TODO-STATE)) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/invariant/sharing-limit\" INVARIANT SHARING-LIMIT ((:ALWAYS (FORALL ((LIST TODOLIST)) (<= (OTHER-PRINCIPAL-COUNT LIST) 256))) (:SCOPE TODO-STATE)) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/state/todo-state\" STATE TODO-STATE ((:AGGREGATE (PER-LIST LISTID)) (:CONSISTENCY SERIAL-PER-LIST) (:DURABILITY DURABLE) (:INITIAL EMPTY) (:OF (AGGREGATE TODOLIST TASK MEMBERSHIP INVITATION)) (:OWNER TODO-APP) (:VERSIONED OPTIMISTIC)) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/due\" TYPE DUE ((:VARIANT ((DATE-ONLY LOCALDATE) (AT ZONEDDATETIME)))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/listid\" TYPE LISTID ((:OPAQUE TEXT)) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/role\" TYPE ROLE ((:ENUM (OWNER EDITOR VIEWER))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/task\" TYPE TASK ((:RECORD ((ID TASKID) (LIST LISTID) (TITLE (TEXT :MIN 1 :MAX 500)) (NOTES (TEXT :MAX 20000)) (STATUS TASKSTATUS) (STATE TASKSTATE) (DUE (OPTIONAL DUE)) (ASSIGNEE (OPTIONAL USERID)) (VERSION VERSION)))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/taskid\" TYPE TASKID ((:OPAQUE TEXT)) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/taskstate\" TYPE TASKSTATE ((:ENUM (ACTIVE TRASHED))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/taskstatus\" TYPE TASKSTATUS ((:ENUM (OPEN COMPLETED))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/todolist\" TYPE TODOLIST ((:RECORD ((ID LISTID) (TITLE (TEXT :MIN 1 :MAX 200)) (OWNER USERID) (VERSION VERSION)))) () FEXPR) #S(GYMNAST-IR-NODE \"todo-spec/type/userid\" TYPE USERID ((:OPAQUE TEXT)) () FEX