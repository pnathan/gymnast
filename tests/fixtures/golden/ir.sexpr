(IR (SCHEMA "gymnast.ir/0.1") (MODULE (NAME TODO-SPEC) (FIELDS ((:EXPORTS (USERID LISTID TASKID TODOLIST TASK TODO-SERVICE)) (:OWNER PRODUCT) (:VERSION "0.1")))) (DESIGN (#S(GYMNAST-IR-NODE "todo-spec/actor/user" ACTOR USER ((:IDENTITY (GOOGLE-OPENID ISSUER SUBJECT)) (:KIND PERSON)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/application/todo" APPLICATION TODO ((:DEFAULT-ACCEPTANCE PRODUCTION) (:MODULES (TODO-SPEC))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/component/todo-app" COMPONENT TODO-APP ((:PROVIDES (TODO-SERVICE)) (:RESPONSIBILITY "Manage persistent, shareable Todo lists") (:USES (GOOGLE-IDENTITY DURABLE-STORE CLOCK ID-SOURCE))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/flow/authenticated-user-to-service" FLOW AUTHENTICATED-USER-TO-SERVICE ((:DENY (RAW-GOOGLE-TOKEN)) (:FROM USER) (:GRANT (AUTHENTICATED-SESSION)) (:KIND COMMAND) (:TO TODO-SERVICE)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/import/oddities" IMPORT ODDITIES ((:ARGUMENTS (PROFILES / TODO-STANDARD "1.0" :SHARING-LIMIT 256 :IDENTITY-PROVIDER GOOGLE)) (:AUTHORITY AUTHORITATIVE) (:VERSION /)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/interface/todo-service" INTERFACE TODO-SERVICE () ((COMMAND CREATE-TASK :ACTOR USER :INPUT (RECORD (LIST LISTID) (TITLE TEXT) (DUE (OPTIONAL DUE))) :OUTPUT TASK :ERRORS (UNAUTHENTICATED FORBIDDEN NOT-FOUND CONFLICT)) (QUERY QUERY-TASKS :ACTOR USER :INPUT (RECORD (LIST LISTID) (CURSOR (OPTIONAL CURSOR))) :OUTPUT (PAGE TASK) :ERRORS (UNAUTHENTICATED NOT-FOUND INVALID-CURSOR)) (COMMAND INVITE :ACTOR USER :INPUT (RECORD (LIST LISTID) (PRINCIPAL USERID) (ROLE ROLE)) :OUTPUT MEMBERSHIP :ERRORS (UNAUTHENTICATED FORBIDDEN NOT-FOUND SHARING-LIMIT))) FEXPR) #S(GYMNAST-IR-NODE "todo-spec/state/todo-state" STATE TODO-STATE ((:AGGREGATE (PER-LIST LISTID)) (:CONSISTENCY SERIAL-PER-LIST) (:DURABILITY DURABLE) (:INITIAL EMPTY) (:OF (AGGREGATE TODOLIST TASK MEMBERSHIP INVITATION)) (:OWNER TODO-APP) (:VERSIONED OPTIMISTIC)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/due" TYPE DUE ((:VARIANT ((DATE-ONLY LOCALDATE) (AT ZONEDDATETIME)))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/listid" TYPE LISTID ((:OPAQUE TEXT)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/role" TYPE ROLE ((:ENUM (OWNER EDITOR VIEWER))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/task" TYPE TASK ((:RECORD ((ID TASKID) (LIST LISTID) (TITLE (TEXT :MIN 1 :MAX 500)) (NOTES (TEXT :MAX 20000)) (STATUS TASKSTATUS) (STATE TASKSTATE) (DUE (OPTIONAL DUE)) (ASSIGNEE (OPTIONAL USERID)) (VERSION VERSION)))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/taskid" TYPE TASKID ((:OPAQUE TEXT)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/taskstate" TYPE TASKSTATE ((:ENUM (ACTIVE TRASHED))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/taskstatus" TYPE TASKSTATUS ((:ENUM (OPEN COMPLETED))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/todolist" TYPE TODOLIST ((:RECORD ((ID LISTID) (TITLE (TEXT :MIN 1 :MAX 200)) (OWNER USERID) (VERSION VERSION)))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/userid" TYPE USERID ((:OPAQUE TEXT)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/type/version" TYPE VERSION ((:OPAQUE INTEGER)) () FEXPR))) (TRANSITIONS (#S(GYMNAST-IR-NODE "todo-spec/behavior/create-task" BEHAVIOR CREATE-TASK ((:ATOMIC (LIST REQUEST / LIST)) (:IDEMPOTENCY COMMAND-KEY) (:ON (TODO-SERVICE / CREATE-TASK USER REQUEST)) (:READS (MEMBERSHIPS TODO-LISTS)) (:WRITES (TASKS))) ((REQUIRES (AUTHENTICATED? USER)) (REQUIRES (MAY-EDIT-LIST? PRE USER REQUEST / LIST)) (ENSURES (= POST (INSERT-TASK PRE REQUEST RESULT))) (RETURNS RESULT) (FAILS FORBIDDEN :WHEN (NOT (MAY-EDIT-LIST? PRE USER REQUEST / LIST)) :PRESERVES ALL-STATE) (EMITS TASK-CREATED :EXACTLY-ONCE-LOGICALLY)) FEXPR) #S(GYMNAST-IR-NODE "todo-spec/behavior/invite-user" BEHAVIOR INVITE-USER ((:ATOMIC (LIST-MEMBERSHIP REQUEST / LIST)) (:IDEMPOTENCY COMMAND-KEY) (:ON (TODO-SERVICE / INVITE USER REQUEST)) (:READS (MEMBERSHIPS INVITATIONS)) (:WRITES (INVITATIONS))) ((REQUIRES (OWNER? PRE USER REQUEST / LIST)) (REQUIRES (< (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256)) (ENSURES (= POST (INVITE-PRINCIPAL PRE REQUEST))) (FAILS SHARING-LIMIT :WHEN (= (OTHER-PRINCIPAL-COUNT PRE REQUEST / LIST) 256) :PRESERVES ALL-STATE)) FEXPR))) (OBLIGATIONS (#S(GYMNAST-IR-NODE "todo-spec/acceptance/production" ACCEPTANCE PRODUCTION ((:SUBJECT TODO-APP)) ((PROPERTY CREATE-THEN-READ :GENERATE ((ACTOR AUTHENTICATED-EDITOR) (TASK VALID-TASK)) :EXECUTE (SEQUENCE (CREATE-TASK ACTOR TASK) (QUERY-TASKS ACTOR TASK / LIST)) :MUST (CONTAINS-EQUIVALENT? RESULT TASK)) (PROPERTY VIEWER-CANNOT-MUTATE :GENERATE ((ACTOR AUTHENTICATED-VIEWER) (TASK VALID-TASK)) :EXECUTE (CREATE-TASK ACTOR TASK) :MUST (FAILS-WITH FORBIDDEN)) (SCENARIO SHARING-BOUNDARY (GIVEN OWNER (AUTHENTICATED-OWNER)) (WHEN (INVITE-DISTINCT OWNER 256)) (THEN SUCCEEDS) (WHEN (INVITE-DISTINCT OWNER 257)) (THEN (FAILS-WITH SHARING-LIMIT))) (CONCURRENCY BOUNDARY-RACE :ACTORS 500 :SCHEDULE ADVERSARIAL :MUST (<= ACTIVE-AND-PENDING-OTHER-PRINCIPALS 256)) (FAULT DURABLE-RESTART :AFTER ACKNOWLEDGED-WRITE :INJECT RESTART :MUST (READ-YOUR-ACKNOWLEDGED-WRITE)) (COVERAGE :EVERY-OPERATION TRUE :EVERY-ERROR TRUE :EVERY-TRANSITION TRUE :EVERY-INVARIANT TRUE :BOUNDARIES TRUE) (EXECUTION :CLOCK VIRTUAL :RANDOMNESS SEEDED :NETWORK CONTROLLED :TIMEZONE "UTC")) FEXPR) #S(GYMNAST-IR-NODE "todo-spec/constraint/collaborative-capacity" CONSTRAINT COLLABORATIVE-CAPACITY ((:CLASS WORKLOAD) (:MUST (AND (= LOST-UPDATES 0) (= INVARIANT-VIOLATIONS 0))) (:SCOPE TODO-SERVICE) (:UNDER (WORKLOAD :VIRTUAL-USERS 500 :DURATION (MINUTES 30) :READ-P95 (MILLISECONDS 300) :WRITE-P95 (MILLISECONDS 500)))) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/invariant/owner-isolation" INVARIANT OWNER-ISOLATION ((:ALWAYS (NO-OBSERVATION-WITHOUT-ACTIVE-MEMBERSHIP)) (:SCOPE TODO-STATE)) () FEXPR) #S(GYMNAST-IR-NODE "todo-spec/invariant/sharing-limit" INVARIANT SHARING-LIMIT ((:ALWAYS (FORALL ((LIST TODOLIST)) (<= (OTHER-PRINCIPAL-COUNT LIST) 256))) (:SCOPE TODO-STATE)) () FEXPR))) (SYNTHESIS (#S(GYMNAST-IR-NODE "todo-spec/synthesis/prototype" SYNTHESIS PROTOTYPE ((:ATTEMPTS 3) (:MODEL (SMALL-CODE-MODEL :CLASS NANO :TEMPERATURE 0 :MAX-ATTEMPTS 3)) (:MUST-NOT (INVENT-PRODUCT-SEMANTICS ADD-UNPINNED-DEPENDENCIES)) (:PLATFORM GYMNAST-REFERENCE-PLATFORM-V1) (:TARGET (RUBY :FRAMEWORK RAILS))) () FEXPR))) (DIAGNOSTICS ()) (FINGERPRINT "fnv1a64:8461216529858395319"))
